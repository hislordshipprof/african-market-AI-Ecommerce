# Copy to .env.local (never committed) and fill in TEST / SANDBOX keys only.
# scripts/ticket-env.txt lists which keys each ticket needs.

# Neon Postgres, dev branch (ADR-0014). Pooled for the app, unpooled/direct for migrations.
# Vercel+Neon integration injects DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
# Local dev uses DIRECT_URL instead.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DIRECT_URL=

# Runtime login password (ADR-0014). The app connects as app_runtime (not the table
# owner) so it cannot bypass RLS. Required in production/preview; optional in dev.
APP_RUNTIME_PASSWORD=

# Better Auth (ADR-0015). Generated by the builder: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Better Auth base URL. On Vercel this falls back to https://$VERCEL_URL automatically.
# Set explicitly only when the auto-detected URL is wrong (e.g. custom domain).
BETTER_AUTH_URL=

# Vercel (ADR-0013), ticket #5
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cloudflare R2 (ADR-0013), ticket #6
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Private bucket for store-delivery proof photos (#134). Never public, never the catalog bucket.
# Unset: staff cannot mark a store-delivery order Delivered.
R2_PROOF_BUCKET=
# Optional: public custom domain for R2. When set, catalog images are served
# from this URL directly. When unset, images are streamed via /api/catalog-image/.
# R2_PUBLIC_URL=

# Stripe TEST mode (spec §14), tickets #4 #10 #18
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Comma-separated. One secret per endpoint: platform refunds, then connected-account events.
STRIPE_WEBHOOK_SECRET=
# Checkout live mode (ADR-0008). Absent = live Stripe keys fail checkout before any Stripe call.
# Only the exact value true enables it; TRUE, 1 and " true" do not. A live/test key mix always fails.
# CHECKOUT_LIVE_MODE=true

# Telnyx SMS (ADR-0017), tickets #3 #12
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Sandbox only. The paid SMS replay test sends here. Never a customer number.
# TELNYX_TEST_TO=

# Resend email, tickets #3 #12
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Inngest (ADR-0016), ticket #12
# INNGEST_DEV=1 sends events to the local Dev Server (npx inngest-cli dev) and needs no event key.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Web Push. Generated by the builder: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Maps, billing capped (ADR-0017), tickets #10 #15
GOOGLE_MAPS_API_KEY=

# DoorDash Drive sandbox, ticket #16
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=

# Uber Direct sandbox, ticket #17
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=

# Anthropic API, separate billing with a spend limit, tickets #20-26.
# Read only when a model call starts. The app builds and starts without it.
ANTHROPIC_API_KEY=

# Shopper assistant (#145). Unset or empty uses claude-haiku-5-5.
# The other allowed value is claude-sonnet-5-5.
ASSISTANT_MODEL=

# Platform spend cap in USD. Unset means 10. A bad value turns the helper off.
ASSISTANT_SPEND_CAP_USD=

# Live shopper-assistant eval (#146). Unset or any value other than 1 refuses to start.
# The default test suite never calls Anthropic. Per-run stop defaults to 2 USD.
# ASSISTANT_EVAL_LIVE=1
# ASSISTANT_EVAL_MAX_USD=2

# Meta WhatsApp Cloud API, ticket #23
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Sentry
SENTRY_DSN=
