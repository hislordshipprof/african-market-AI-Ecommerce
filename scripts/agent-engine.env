# Which headless agent CLI the pipeline scripts run (plan, build, ship). No secrets here.
# ENGINE=claude  -> Claude Code (`claude -p`)
# ENGINE=cursor  -> Cursor CLI (`agent -p`), signed in once with `agent login` (uses the Cursor subscription)
# Override per run with AGENT_ENGINE=claude|cursor.
ENGINE=cursor

# Independent review engine (owner decision 2026-11-03: builders on Cursor/Grok, reviews on Codex).
# REVIEW_ENGINE=codex runs `codex exec`; anything else uses ENGINE. Override per run with REVIEW_ENGINE=...
REVIEW_ENGINE=codex
# Owner decision 2026-11-04 (Codex usage nearly exhausted): GPT-6.1 Sol at high effort, about 1/5 of Astra's
# price. Codex runs only (a) the main review on RISK tickets (money, auth, external providers) and (b) one
# final confirming pass when a non-RISK ticket's Cursor review says PASS (CODEX_FINAL_PASS=on). Every other
# review round runs on Cursor (CURSOR_REVIEW_MODEL), so earlier rounds cost no Codex usage.
CODEX_REVIEW_MODEL=gpt-6.1-sol
CODEX_REVIEW_EFFORT=high
CODEX_FINAL_PASS=on
# Owner decision 2026-11-03: Codex reviews run unsandboxed so they can run vitest/playwright
# (the workspace-write sandbox blocks them with spawn EPERM). Set to "on" to sandbox again.
CODEX_REVIEW_SANDBOX=off

# Cursor models (names from `agent models`). Builders and reviewers are different model families,
# so no model reviews its own work.
CURSOR_BUILD_MODEL=grok-4.7-high
CURSOR_LIGHT_MODEL=grok-4.7-medium
CURSOR_PLAN_MODEL=claude-opus-5-5-high
# Reviewer for non-RISK review rounds, and second reviewer on RISK tickets next to Codex.
CURSOR_REVIEW_MODEL=claude-opus-5-5-high
# Brief review attacks the planner's brief, and the planner is Opus, so it runs on a different family.
CURSOR_BRIEF_REVIEW_MODEL=grok-4.7-high
