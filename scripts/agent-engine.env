# Which headless agent CLI the pipeline scripts run (plan, build, ship). No secrets here.
# ENGINE=claude  -> Claude Code (`claude -p`)
# ENGINE=cursor  -> Cursor CLI (`agent -p`), signed in once with `agent login` (uses the Cursor subscription)
# Override per run with AGENT_ENGINE=claude|cursor.
# Owner 2026-11-07 night: every role (plan, build, fix, review) runs on Claude on the Ben profile
# (~/.claude-second) until the owner says to switch back. Back to Cursor: ENGINE=cursor and delete AGENT_CLAUDE_CONFIG_DIR.
ENGINE=claude
AGENT_CLAUDE_CONFIG_DIR="${USERPROFILE:-$HOME}/.claude-second"

# Independent review engine. Owner decision 2026-11-07: Codex is out of usage, so reviews run on Claude on the
# Ben profile (REVIEW_CLAUDE_CONFIG_DIR).
# REVIEW_ENGINE=codex|cursor|claude. Override per run with REVIEW_ENGINE=... (back to codex when its usage returns).
REVIEW_ENGINE=claude
REVIEW_CLAUDE_CONFIG_DIR="${USERPROFILE:-$HOME}/.claude-second"
REVIEW_CLAUDE_MODEL=claude-opus-5-5
# Used only when REVIEW_ENGINE=codex, and by the standalone scripts/codex-review.sh.
CODEX_REVIEW_MODEL=gpt-6.1-sol
CODEX_REVIEW_EFFORT=high
# Owner decision 2026-11-03: Codex reviews run unsandboxed so they can run vitest/playwright
# (the workspace-write sandbox blocks them with spawn EPERM). Set to "on" to sandbox again.
CODEX_REVIEW_SANDBOX=off

# Cursor models (names from `agent models`). Builders and reviewers are different model families,
# so no model reviews its own work.
CURSOR_BUILD_MODEL=grok-4.7-high
CURSOR_LIGHT_MODEL=grok-4.7-medium
CURSOR_PLAN_MODEL=claude-opus-5-5-high
# Second reviewer on RISK tickets (money, auth, external providers), a fresh session on Cursor.
CURSOR_REVIEW_MODEL=claude-opus-5-5-high
