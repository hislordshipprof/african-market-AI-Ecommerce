# Which headless agent CLI the pipeline scripts run (plan, build, ship). No secrets here.
# ENGINE=claude  -> Claude Code (`claude -p`)
# ENGINE=cursor  -> Cursor CLI (`agent -p`), signed in once with `agent login` (uses the Cursor subscription)
# Override per run with AGENT_ENGINE=claude|cursor.
ENGINE=cursor

# Independent review engine (owner decision 2026-11-03: builders on Cursor/Grok, reviews on Codex).
# REVIEW_ENGINE=codex runs `codex exec`; anything else uses ENGINE. Override per run with REVIEW_ENGINE=...
REVIEW_ENGINE=codex
CODEX_REVIEW_MODEL=gpt-6-astra
CODEX_REVIEW_EFFORT=medium

# Cursor models (names from `agent models`). Builders and reviewers are different model families,
# so no model reviews its own work.
CURSOR_BUILD_MODEL=grok-4.7-high
CURSOR_LIGHT_MODEL=grok-4.7-medium
CURSOR_PLAN_MODEL=claude-opus-5-5-high
# Second reviewer on RISK tickets (money, auth, external providers), next to Codex.
CURSOR_REVIEW_MODEL=claude-opus-5-5-high
