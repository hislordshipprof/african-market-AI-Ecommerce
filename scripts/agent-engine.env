# Which headless agent CLI the pipeline scripts run (build, review, plan, ship). No secrets here.
# ENGINE=claude  -> Claude Code (`claude -p`)
# ENGINE=cursor  -> Cursor CLI (`agent -p`), signed in once with `agent login` (uses the Cursor subscription)
# Override per run with AGENT_ENGINE=claude|cursor.
ENGINE=claude

# Cursor models (names from `agent models`). Builders and reviewers use different model families,
# so no model reviews its own work.
CURSOR_BUILD_MODEL=
CURSOR_LIGHT_MODEL=
CURSOR_REVIEW_MODEL=
CURSOR_PLAN_MODEL=
