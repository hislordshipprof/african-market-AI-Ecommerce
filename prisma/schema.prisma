generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  logoUrl              String?  @map("logo_url")
  brandColor           String?  @map("brand_color")
  themePreset          String   @default("palm-and-shea") @map("theme_preset")
  status               String   @default("active")
  hours                Json?
  timezone             String   @default("America/New_York")
  prepTimeMinutes      Int      @default(30) @map("prep_time_minutes")
  deliveryRadiusMi     Decimal  @default(8) @map("delivery_radius_mi")
  minimumOrderCents    Int      @default(3500) @map("minimum_order_cents")
  pickupEnabled        Boolean  @default(false) @map("pickup_enabled")
  autoAcceptOrders     Boolean  @default(false) @map("auto_accept_orders")
  autoRefundLimitCents    Int      @default(2500) @map("auto_refund_limit_cents")
  stripeAccountId        String?  @unique @map("stripe_account_id")
  stripeOnboardingStatus String   @default("not_started") @map("stripe_onboarding_status")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  ownerName            String?  @map("owner_name")
  ownerStory           String?  @map("owner_story")
  ownerPhotoUrl        String?  @map("owner_photo_url")
  neighborhood         String?
  deliveryInfo         String?  @map("delivery_info")

  rlsFixtures  RlsTestFixture[]
  auditLogs    AuditLog[]
  memberships  StoreMembership[]
  invites      StoreInvite[]
  listings     Listing[]
  stockEvents  StockEvent[]
  banners      StoreBanner[]
  collections  StoreCollection[]
  carts        Cart[]
  customers    Customer[]
  orders          Order[]
  refundRequests  RefundRequest[]
  listingImports  ListingImport[]
  aiConversations AiConversation[]
  aiActions       AiAction[]
  assistantUndoReceipts AssistantUndoReceipt[]
  guestBrowserCarts GuestBrowserCart[]
  paymentIntentReleases PaymentIntentRelease[]

  @@map("stores")
}

/// RLS test fixture: placeholder store-owned table for isolation tests until real entities exist.
model RlsTestFixture {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@map("store_content")
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  role             String    @default("customer")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions                 Session[]
  accounts                 Account[]
  twoFactor                TwoFactor[]
  auditLogs                AuditLog[]
  memberships              StoreMembership[]
  invitesSent              StoreInvite[]
  stockEvents              StockEvent[]
  customers                Customer[]
  carts                    Cart[]
  listingImports           ListingImport[]
  platformCustomerProfile  PlatformCustomerProfile?
  customerAddresses        CustomerAddress[]
  cardSaveConsents         CardSaveConsent[]

  @@map("users")
}

model Session {
  id                String   @id
  expiresAt         DateTime @map("expires_at")
  token             String   @unique
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  userId            String   @map("user_id")
  twoFactorVerified Boolean  @default(false) @map("two_factor_verified")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model TwoFactor {
  id                     String    @id
  secret                 String
  backupCodes            String    @map("backup_codes")
  userId                 String    @map("user_id")
  verified               Boolean   @default(false)
  failedVerificationCount Int      @default(0) @map("failed_verification_count")
  lockedUntil            DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String?  @map("store_id")
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  store Store? @relation(fields: [storeId], references: [id])
  actor User   @relation(fields: [actorId], references: [id])

  @@index([storeId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model StoreMembership {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_memberships")
}

model StoreInvite {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  email       String
  role        String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  invitedById String    @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  store     Store @relation(fields: [storeId], references: [id])
  invitedBy User  @relation(fields: [invitedById], references: [id])

  @@index([storeId])
  @@index([email])
  @@map("store_invites")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  localName String?  @map("local_name")
  imageUrl  String?  @map("image_url")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  masterProducts MasterProduct[]

  @@map("categories")
}

model MasterProduct {
  id              String    @id @default(cuid())
  name            String
  categoryId      String?   @map("category_id")
  description     String?
  imageUrl        String?   @map("image_url")
  imageSourceUrl  String?   @map("image_source_url")
  imageAuthor     String?   @map("image_author")
  imageLicense    String?   @map("image_license")
  unit            String?
  weightG         Int?      @map("weight_g")
  frozen          Boolean   @default(false)
  perishable      Boolean   @default(false)
  storage         String?
  subcategory     String?
  originCountries String?   @map("origin_countries")
  status          String    @default("active")
  confidence      String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category Category?  @relation(fields: [categoryId], references: [id])
  listings Listing[]
  synonyms ProductSynonym[]

  @@index([categoryId])
  @@index([status])
  @@map("master_products")
}

model ProductSynonym {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  term      String
  language  String?
  region    String?
  createdAt DateTime @default(now()) @map("created_at")

  masterProduct MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([term])
  @@map("product_synonyms")
}

model Listing {
  id                    String    @id @default(cuid())
  storeId               String    @map("store_id")
  masterProductId       String?   @map("master_product_id")
  customName            String?   @map("custom_name")
  price                 Int
  stockMode             String    @map("stock_mode")
  qty                   Int?
  status                String?
  frozen                Boolean   @default(false)
  perishable            Boolean   @default(false)
  maxPerOrder           Int?      @map("max_per_order")
  active                Boolean   @default(true)
  confidence            Float     @default(1.0)
  confidenceUpdatedAt   DateTime  @default(now()) @map("confidence_updated_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  store          Store          @relation(fields: [storeId], references: [id])
  masterProduct  MasterProduct? @relation(fields: [masterProductId], references: [id])
  variants       ListingVariant[]
  stockEvents    StockEvent[]
  collectionItems StoreCollectionListing[]

  @@index([storeId])
  @@index([storeId, active])
  @@index([masterProductId])
  @@map("listings")
}

model ListingVariant {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  label     String
  price     Int
  weightG           Int      @map("weight_g")
  weightPlaceholder Boolean  @default(false) @map("weight_placeholder")
  sku               String?
  barcode   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cartLines                CartLine[]
  substituteCartLines      CartLine[]  @relation("substituteVariant")
  orderLines               OrderLine[]
  substituteOrderLines     OrderLine[] @relation("substituteOrderLine")

  @@index([listingId])
  @@map("listing_variants")
}

model StockEvent {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  listingId String   @map("listing_id")
  type      String
  delta     Int
  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([storeId])
  @@index([listingId])
  @@index([actorId])
  @@map("stock_events")
}

model StoreBanner {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  title     String
  subtitle  String?
  ctaText   String?  @map("cta_text")
  ctaHref   String?  @map("cta_href")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, active, sortOrder])
  @@map("store_banners")
}

model StoreCollection {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  title       String
  subtitle    String?
  imageUrl    String?  @map("image_url")
  slug        String
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    Store                    @relation(fields: [storeId], references: [id])
  items    StoreCollectionListing[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, active, sortOrder])
  @@map("store_collections")
}

model StoreCollectionListing {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  listingId    String   @map("listing_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([collectionId, listingId])
  @@index([collectionId])
  @@index([listingId])
  @@map("store_collection_listings")
}

model Cart {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  userId          String?  @map("user_id")
  customerId      String?  @map("customer_id")
  paymentIntentId     String? @unique @map("payment_intent_id")
  paymentAttemptToken String? @map("payment_attempt_token")
  purchaseEpoch       Int     @default(0) @map("purchase_epoch")
  source              String  @default("manual")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store    Store     @relation(fields: [storeId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id])
  lines    CartLine[]
  aiConversations AiConversation[]
  assistantUndoReceipts AssistantUndoReceipt[]
  guestBrowserCarts GuestBrowserCart[]

  @@index([storeId])
  @@index([storeId, userId])
  @@index([userId])
  @@index([customerId])
  @@map("carts")
}

/// A PaymentIntent reserved for release. Placement and release take the same
/// locks, and this row is the decision: the intent becomes an order, or it is
/// released. Stripe is told only after the row commits.
model PaymentIntentRelease {
  paymentIntentId String   @id @map("payment_intent_id")
  storeId         String   @map("store_id")
  createdAt       DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("payment_intent_releases")
}

model CartLine {
  id                  String   @id @default(cuid())
  storeId             String   @map("store_id")
  cartId              String   @map("cart_id")
  variantId           String   @map("variant_id")
  qty                 Int
  source              String   @default("manual")
  swapRule            String   @default("exact_only") @map("swap_rule")
  substituteVariantId String?  @map("substitute_variant_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant           ListingVariant  @relation(fields: [variantId], references: [id])
  substituteVariant ListingVariant? @relation("substituteVariant", fields: [substituteVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([storeId])
  @@index([cartId])
  @@index([variantId])
  @@index([substituteVariantId])
  @@map("cart_lines")
}

model Customer {
  id               String   @id @default(cuid())
  storeId          String   @map("store_id")
  userId           String?  @map("user_id")
  name             String
  email            String?
  phone            String?
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store  Store    @relation(fields: [storeId], references: [id])
  user   User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders Order[]
  carts  Cart[]
  aiConversations AiConversation[]

  @@unique([id, storeId])
  @@index([storeId])
  @@index([storeId, email])
  @@index([userId])
  @@map("customers")
}

/// Shopper assistant transcript. One row per cart. Store copilot records are #142/#144.
model AiConversation {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  cartId        String    @map("cart_id")
  customerId    String?   @map("customer_id")
  model         String
  tokensIn      Int       @default(0) @map("tokens_in")
  tokensOut     Int       @default(0) @map("tokens_out")
  costMicros    BigInt    @default(0) @map("cost_micros")
  messages      Json      @default("[]")
  inFlightUntil DateTime? @map("in_flight_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  actions  AiAction[]

  @@unique([storeId, cartId])
  @@index([storeId])
  @@index([createdAt])
  @@index([customerId])
  @@map("ai_conversations")
}

model AiAction {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  conversationId String   @map("conversation_id")
  tool           String
  input          Json
  output         Json
  ok             Boolean
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([storeId])
  @@index([createdAt])
  @@map("ai_actions")
}

/// One row per assistant addition the customer undoes. A retry sees the row and does not subtract again.
model AssistantUndoReceipt {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  cartId     String   @map("cart_id")
  lineId     String   @map("line_id")
  additionId String   @map("addition_id")
  subtracted Int
  createdAt  DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([storeId, cartId, additionId])
  @@index([storeId])
  @@index([cartId])
  @@map("assistant_undo_receipts")
}

/// The cart a browser opened before its cart cookie was stored. One browser, one guest cart.
model GuestBrowserCart {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  browserId String   @map("browser_id")
  cartId    String   @map("cart_id")
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([storeId, browserId])
  @@index([cartId])
  @@map("guest_browser_carts")
}

/// Platform-wide shopper-assistant spend. No store id, and retention does not delete it.
model AssistantSpendDay {
  day          DateTime  @id @db.Date
  costMicros   BigInt    @default(0) @map("cost_micros")
  capAlertedAt DateTime? @map("cap_alerted_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("assistant_spend_days")
}

/// One row per provider call so a lost acknowledgement cannot increment the day twice.
model AssistantSpendCall {
  id         String   @id
  day        DateTime @db.Date
  costMicros BigInt   @map("cost_micros")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("assistant_spend_calls")
}

/// Committed retention batch. A replay of the same key returns this count.
model AssistantRetentionBatch {
  id      String @id
  deleted Int

  @@map("assistant_retention_batches")
}

model Order {
  id                   String    @id @default(cuid())
  storeId              String    @map("store_id")
  number               Int
  customerId           String    @map("customer_id")
  status               String    @default("AUTHORIZED")
  fulfillment          String    @default("pickup")
  pickupSlot           String?   @map("pickup_slot")
  subtotalCents        Int       @map("subtotal_cents")
  tipCents             Int       @default(0) @map("tip_cents")
  bufferCents          Int       @map("buffer_cents")
  totalAuthorizedCents Int       @map("total_authorized_cents")
  paymentIntentId      String?   @unique @map("payment_intent_id")
  sourceCartId         String?   @map("source_cart_id")
  capturedAmountCents  Int?      @map("captured_amount_cents")
  refundId             String?   @map("refund_id")
  platformFeeCents     Int?      @map("platform_fee_cents")
  deliveryFeeCents     Int       @default(0) @map("delivery_fee_cents")
  totalCents           Int       @default(0) @map("total_cents")
  notes                String?
  prepEstimateMinutes  Int?      @map("prep_estimate_minutes")
  acceptedAt           DateTime? @map("accepted_at")
  readyAt              DateTime? @map("ready_at")
  completedAt          DateTime? @map("completed_at")
  cancelledAt          DateTime? @map("cancelled_at")
  inngestEventSentAt   DateTime? @map("inngest_event_sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  store    Store      @relation(fields: [storeId], references: [id])
  customer Customer   @relation(fields: [customerId, storeId], references: [id, storeId])
  lines    OrderLine[]
  refundRequests RefundRequest[]

  @@unique([id, storeId])
  @@unique([storeId, number])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, sourceCartId, createdAt])
  @@index([customerId])
  @@map("orders")
}

/// One refund the app asked Stripe for. Stripe owns the outcome; this row owns the request.
model RefundRequest {
  id                   String   @id @default(cuid())
  storeId              String   @map("store_id")
  orderId              String   @map("order_id")
  paymentIntentId      String   @map("payment_intent_id")
  key                  String   @unique
  amountCents          Int      @map("amount_cents")
  refundApplicationFee Boolean  @map("refund_application_fee")
  state                String
  providerRefundId     String?  @map("provider_refund_id")
  providerStatus       String?  @map("provider_status")
  createdAt            DateTime @default(now()) @map("created_at")
  lastCheckedAt        DateTime @default(now()) @map("last_checked_at")

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
  @@index([storeId, state])
  @@map("refund_requests")
}

model OrderLine {
  id                  String   @id @default(cuid())
  storeId             String   @map("store_id")
  orderId             String   @map("order_id")
  listingVariantId    String   @map("listing_variant_id")
  substituteVariantId String?  @map("substitute_variant_id")
  qtyOrdered          Int      @map("qty_ordered")
  qtyPicked           Int      @default(0) @map("qty_picked")
  unitPriceCents      Int      @map("unit_price_cents")
  swapRule            String   @default("exact_only") @map("swap_rule")
  status              String   @default("pending")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  order              Order          @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  listingVariant     ListingVariant @relation(fields: [listingVariantId], references: [id])
  substituteVariant  ListingVariant? @relation("substituteOrderLine", fields: [substituteVariantId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([orderId])
  @@index([listingVariantId])
  @@index([substituteVariantId])
  @@map("order_lines")
}

model ListingImport {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  csvText     String    @map("csv_text")
  rowCount    Int       @map("row_count")
  status      String    @default("pending")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  committedAt DateTime? @map("committed_at")

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([storeId, status])
  @@map("listing_imports")
}

/// Platform account profile. One row per login. Not store-scoped.
model PlatformCustomerProfile {
  userId                        String    @id @map("user_id")
  stripeCustomerId              String?   @unique @map("stripe_customer_id")
  stripeCustomerStatus          String?   @map("stripe_customer_status")
  stripeCustomerIdempotencyKey  String?   @map("stripe_customer_idempotency_key")
  stripeCustomerAttemptedAt     DateTime? @map("stripe_customer_attempted_at")
  phone                         String?
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_customer_profiles")
}

/// A delivery address saved on the customer's account. Copied onto an order only by #15.
model CustomerAddress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  notes     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

/// Affirmative consent to reuse a card at any store. The payment method id is a Stripe token, not card data.
model CardSaveConsent {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  paymentIntentId   String   @map("payment_intent_id")
  paymentMethodId   String?  @map("payment_method_id")
  stripeCustomerId  String?  @map("stripe_customer_id")
  termsVersion      String   @map("terms_version")
  purpose           String
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, paymentMethodId])
  @@map("card_save_consents")
}
