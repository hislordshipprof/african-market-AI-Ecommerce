generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  customDomain         String?  @unique @map("custom_domain")
  logoUrl              String?  @map("logo_url")
  brandColor           String?  @map("brand_color")
  themePreset          String   @default("palm-and-shea") @map("theme_preset")
  status               String   @default("active")
  hours                Json?
  timezone             String   @default("America/New_York")
  prepTimeMinutes      Int      @default(30) @map("prep_time_minutes")
  deliveryRadiusMi     Decimal  @default(8) @map("delivery_radius_mi")
  storeDeliveryEnabled Boolean  @default(false) @map("store_delivery_enabled")
  storeDeliveryFeeCents Int     @default(0) @map("store_delivery_fee_cents")
  addressLine1         String?  @map("address_line1")
  addressLine2         String?  @map("address_line2")
  city                 String?
  state                String?
  zip                  String?
  lat                  Float?
  lng                  Float?
  minimumOrderCents    Int      @default(3500) @map("minimum_order_cents")
  pickupEnabled        Boolean  @default(false) @map("pickup_enabled")
  autoAcceptOrders     Boolean  @default(false) @map("auto_accept_orders")
  autoRefundLimitCents    Int      @default(2500) @map("auto_refund_limit_cents")
  supportSlaMinutes       Int      @default(30) @map("support_sla_minutes")
  digestHour              Int      @default(20) @map("digest_hour")
  stripeAccountId        String?  @unique @map("stripe_account_id")
  stripeOnboardingStatus String   @default("not_started") @map("stripe_onboarding_status")
  /// DoorDash Drive external_store_id, set once the platform registers the store (#135).
  doordashStoreId        String?  @unique @map("doordash_store_id")
  /// Uber Direct organization id, set once the platform registers the store (#139).
  uberLocationId         String?  @unique @map("uber_location_id")
  /// Why the last Uber Direct registration failed; set means the store needs a retry (#139).
  uberRegistrationError  String?  @map("uber_registration_error")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  ownerName            String?  @map("owner_name")
  ownerStory           String?  @map("owner_story")
  ownerPhotoUrl        String?  @map("owner_photo_url")
  neighborhood         String?
  deliveryInfo         String?  @map("delivery_info")

  rlsFixtures  RlsTestFixture[]
  auditLogs    AuditLog[]
  memberships  StoreMembership[]
  invites      StoreInvite[]
  listings     Listing[]
  listingAttributes     ListingAttributes[]
  listingIngredients    ListingIngredient[]
  stockEvents  StockEvent[]
  banners      StoreBanner[]
  collections  StoreCollection[]
  carts        Cart[]
  customers    Customer[]
  orders          Order[]
  deliveries      Delivery[]
  refundRequests  RefundRequest[]
  issueReports    IssueReport[]
  substitutionRequests SubstitutionRequest[]
  listingImports  ListingImport[]
  aiConversations AiConversation[]
  aiActions       AiAction[]
  assistantUndoReceipts AssistantUndoReceipt[]
  guestBrowserCarts GuestBrowserCart[]
  paymentIntentReleases PaymentIntentRelease[]
  copilotConversations CopilotConversation[]
  copilotClientMessages CopilotClientMessage[]
  stockProposals StockProposal[]
  copilotAlerts  CopilotAlert[]
  copilotDigests CopilotDigest[]
  ownerReports OwnerReport[]
  ownerReportItems OwnerReportItem[]
  notificationLogs NotificationLog[]
  deliveryEvents DeliveryEvent[]
  pushSubscriptions PushSubscription[]
  supportThreads SupportThread[]
  supportMessages SupportMessage[]
  subscription    StoreSubscription?
  billingEvents   StripeBillingEvent[]
  assistantChatMonths AssistantChatMonth[]

  @@map("stores")
}

/// RLS test fixture: placeholder store-owned table for isolation tests until real entities exist.
model RlsTestFixture {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@map("store_content")
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  role             String    @default("customer")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions                 Session[]
  accounts                 Account[]
  twoFactor                TwoFactor[]
  auditLogs                AuditLog[]
  memberships              StoreMembership[]
  invitesSent              StoreInvite[]
  stockEvents              StockEvent[]
  customers                Customer[]
  carts                    Cart[]
  listingImports           ListingImport[]
  platformCustomerProfile  PlatformCustomerProfile?
  customerAddresses        CustomerAddress[]
  cardSaveConsents         CardSaveConsent[]
  pushSubscriptions        PushSubscription[]
  supportMessages          SupportMessage[]
  copilotConversations     CopilotConversation[]
  stockProposalDecisions   StockProposal[] @relation("StockProposalDecision")
  copilotAlertResolutions  CopilotAlert[]  @relation("CopilotAlertResolution")
  ownerReports             OwnerReport[]   @relation("OwnerReportActor")
  ownerReportDecisions     OwnerReport[]   @relation("OwnerReportDecision")

  @@map("users")
}

model Session {
  id                String   @id
  expiresAt         DateTime @map("expires_at")
  token             String   @unique
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  userId            String   @map("user_id")
  twoFactorVerified Boolean  @default(false) @map("two_factor_verified")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model TwoFactor {
  id                     String    @id
  secret                 String
  backupCodes            String    @map("backup_codes")
  userId                 String    @map("user_id")
  verified               Boolean   @default(false)
  failedVerificationCount Int      @default(0) @map("failed_verification_count")
  lockedUntil            DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// File-turn counter for the shopper assistant. Not store-owned: the key is
/// `assistant:files:cart:<cartId>` after the cart is resolved in that store.
/// Better Auth prunes `rate_limits` after 60 seconds, so this hour-long counter
/// cannot live there.
model AssistantFileTurn {
  id   String @id @default(cuid())
  key  String
  atMs BigInt @map("at_ms")

  @@index([key, atMs])
  @@map("assistant_file_turns")
}

/// Platform counters. Not store-owned: no store_id and no RLS, same grants as rate_limits.
/// Better Auth prunes rate_limits; it never touches this table.
model AppRateLimit {
  key         String @id
  windowStart BigInt @map("window_start")
  count       Int

  @@index([windowStart])
  @@map("app_rate_limits")
}

/// Shared Census match. Not store-owned: the key is a normalized address, and
/// the row never stores a distance or an inside/outside result.
model AddressGeocode {
  key              String   @id
  line1            String
  city             String
  state            String
  zip              String
  formattedAddress String   @map("formatted_address")
  lat              Float
  lng              Float
  cachedAt         DateTime @map("cached_at")

  @@map("address_geocodes")
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String?  @map("store_id")
  actorId    String   @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  store Store? @relation(fields: [storeId], references: [id])
  actor User   @relation(fields: [actorId], references: [id])

  @@index([storeId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model StoreMembership {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_memberships")
}

model StoreInvite {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  email       String
  role        String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  invitedById String    @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  store     Store @relation(fields: [storeId], references: [id])
  invitedBy User  @relation(fields: [invitedById], references: [id])

  @@index([storeId])
  @@index([email])
  @@map("store_invites")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  localName String?  @map("local_name")
  imageUrl  String?  @map("image_url")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  masterProducts MasterProduct[]

  @@map("categories")
}

model MasterProduct {
  id              String    @id @default(cuid())
  name            String
  categoryId      String?   @map("category_id")
  description     String?
  imageUrl        String?   @map("image_url")
  imageSourceUrl  String?   @map("image_source_url")
  imageAuthor     String?   @map("image_author")
  imageLicense    String?   @map("image_license")
  unit            String?
  weightG         Int?      @map("weight_g")
  frozen          Boolean   @default(false)
  perishable      Boolean   @default(false)
  storage         String?
  subcategory     String?
  originCountries String?   @map("origin_countries")
  status          String    @default("active")
  confidence      String?
  ingredientsStatus String   @default("unknown") @map("ingredients_status")
  allergens         String[] @default([])
  allergensStatus   String   @default("unknown") @map("allergens_status")
  dietaryClaims     String[] @default([]) @map("dietary_claims")
  dietaryStatus     String   @default("unknown") @map("dietary_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category Category?  @relation(fields: [categoryId], references: [id])
  listings Listing[]
  synonyms ProductSynonym[]
  ingredients        MasterProductIngredient[]
  attributeProposals AttributeProposal[]
  recipeIngredients  RecipeIngredient[]

  @@index([categoryId])
  @@index([status])
  @@map("master_products")
}

model ProductSynonym {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  term      String
  language  String?
  region    String?
  createdAt DateTime @default(now()) @map("created_at")

  masterProduct MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([term])
  @@map("product_synonyms")
}

model Ingredient {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  synonyms       IngredientSynonym[]
  masterProducts MasterProductIngredient[]
  listings       ListingIngredient[]

  @@map("ingredients")
}

model IngredientSynonym {
  id           String   @id @default(cuid())
  ingredientId String   @map("ingredient_id")
  term         String   @unique
  language     String?
  createdAt    DateTime @default(now()) @map("created_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@map("ingredient_synonyms")
}

model MasterProductIngredient {
  productId    String @map("product_id")
  ingredientId String @map("ingredient_id")

  masterProduct MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("master_product_ingredients")
}

model AttributeProposal {
  id              String    @id @default(cuid())
  productId       String    @map("product_id")
  ingredientsRead Boolean   @map("ingredients_read")
  ingredients     String[]  @default([])
  allergensRead   Boolean   @map("allergens_read")
  allergens       String[]  @default([])
  dietaryRead     Boolean   @map("dietary_read")
  dietaryClaims   String[]  @default([]) @map("dietary_claims")
  status          String    @default("pending")
  model           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?   @map("reviewed_by")

  masterProduct MasterProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId])
  @@map("attribute_proposals")
}

model Listing {
  id                    String    @id @default(cuid())
  storeId               String    @map("store_id")
  masterProductId       String?   @map("master_product_id")
  customName            String?   @map("custom_name")
  price                 Int
  stockMode             String    @map("stock_mode")
  qty                   Int?
  status                String?
  frozen                Boolean   @default(false)
  perishable            Boolean   @default(false)
  maxPerOrder           Int?      @map("max_per_order")
  active                Boolean   @default(true)
  confidence            Float     @default(1.0)
  confidenceUpdatedAt   DateTime  @default(now()) @map("confidence_updated_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  store          Store          @relation(fields: [storeId], references: [id])
  masterProduct  MasterProduct? @relation(fields: [masterProductId], references: [id])
  variants       ListingVariant[]
  stockEvents    StockEvent[]
  ownerReportItems OwnerReportItem[]
  collectionItems StoreCollectionListing[]
  attributes       ListingAttributes?
  ingredients      ListingIngredient[]

  @@index([storeId])
  @@index([storeId, active])
  @@index([masterProductId])
  @@map("listings")
}

model ListingAttributes {
  listingId         String   @id @map("listing_id")
  storeId           String   @map("store_id")
  ingredientsStatus String?  @map("ingredients_status")
  allergens         String[] @default([])
  allergensStatus   String?  @map("allergens_status")
  dietaryClaims     String[] @default([]) @map("dietary_claims")
  dietaryStatus     String?  @map("dietary_status")
  updatedAt         DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("listing_attributes")
}

model ListingIngredient {
  listingId    String @map("listing_id")
  ingredientId String @map("ingredient_id")
  storeId      String @map("store_id")

  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  store      Store      @relation(fields: [storeId], references: [id])

  @@id([listingId, ingredientId])
  @@index([storeId])
  @@index([ingredientId])
  @@map("listing_ingredients")
}

model ListingVariant {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  label     String
  price     Int
  weightG           Int      @map("weight_g")
  weightPlaceholder Boolean  @default(false) @map("weight_placeholder")
  sku               String?
  barcode   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cartLines                CartLine[]
  substituteCartLines      CartLine[]  @relation("substituteVariant")
  orderLines               OrderLine[]
  substituteOrderLines     OrderLine[] @relation("substituteOrderLine")
  substitutedOrderLines    OrderLine[] @relation("substitutedOrderLine")
  substitutionProposals    SubstitutionRequest[]

  @@index([listingId])
  @@map("listing_variants")
}

model StockEvent {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  listingId String   @map("listing_id")
  type      String
  delta     Int
  actorId   String   @map("actor_id")
  idempotencyKey String? @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])
  actor   User    @relation(fields: [actorId], references: [id])

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([listingId])
  @@index([actorId])
  @@index([storeId, listingId, createdAt])
  @@map("stock_events")
}

/// Owner copilot thread. Shopper transcripts stay on ai_conversations.
model CopilotConversation {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  userId        String    @map("user_id")
  model         String
  messages      Json      @default("[]")
  inFlightUntil DateTime? @map("in_flight_until")
  tokensIn      Int       @default(0) @map("tokens_in")
  tokensOut     Int       @default(0) @map("tokens_out")
  costMicros    BigInt    @default(0) @map("cost_micros")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  proposals StockProposal[]
  receipts CopilotClientMessage[]

  @@index([storeId])
  @@index([storeId, userId, lastMessageAt])
  @@map("copilot_conversations")
}

/// One row per owner send, so a repeated client message id replays without a second model call.
model CopilotClientMessage {
  id              String    @id @default(cuid())
  storeId         String    @map("store_id")
  userId          String    @map("user_id")
  conversationId  String?   @map("conversation_id")
  clientMessageId String    @map("client_message_id")
  reply           String?
  claimedUntil    DateTime  @map("claimed_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  store        Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation CopilotConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, clientMessageId])
  @@index([storeId])
  @@index([conversationId])
  @@map("copilot_client_messages")
}

/// A stock change the owner has not applied until they tap confirm. No stock-event foreign key.
model StockProposal {
  id              String    @id @default(cuid())
  storeId         String    @map("store_id")
  conversationId  String    @map("conversation_id")
  listingId       String    @map("listing_id")
  clientMessageId String    @map("client_message_id")
  kind            String
  quantity        Int?
  statusValue     String?   @map("status_value")
  before          Json
  state           String
  expiresAt       DateTime  @map("expires_at")
  decidedById     String?   @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  decidedBy    User?               @relation("StockProposalDecision", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([storeId, listingId, state])
  @@index([storeId, clientMessageId])
  @@index([conversationId])
  @@index([listingId])
  @@index([decidedById])
  @@map("stock_proposals")
}

/// A stock alert or confirm-request for the owner. No foreign key to listings or orders: RLS checks them.
model CopilotAlert {
  id           String    @id @default(cuid())
  storeId      String    @map("store_id")
  kind         String
  listingId    String    @map("listing_id")
  orderId      String?   @map("order_id")
  state        String    @default("open")
  dedupeKey    String    @map("dedupe_key")
  pushedAt     DateTime? @map("pushed_at")
  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  store      Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("CopilotAlertResolution", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@unique([storeId, dedupeKey])
  @@index([storeId, state, pushedAt])
  @@index([storeId, listingId, state])
  @@index([resolvedById])
  @@map("copilot_alerts")
}

/// One per store per local day, claimed before the digest email goes out; sent_at is set once every owner has it.
model CopilotDigest {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  localDate String   @map("local_date")
  /// Rendered once at claim time, so a retry resends the same body under the same Resend idempotency key.
  html      String
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, localDate])
  @@map("copilot_digests")
}

/// A voice or photo stock report from a store member (#21). Nothing is written to stock until the owner confirms.
model OwnerReport {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  actorId       String    @map("actor_id")
  /// voice | invoice_photo | shelf_photo
  type          String
  /// pending | confirmed | rejected | partial
  status        String    @default("pending")
  rawTranscript String?   @map("raw_transcript")
  imageKey      String?   @map("image_key")
  /// sha256 of the type and the transcript or photo bytes; one pending report per store per hash (partial unique index in SQL).
  sourceHash    String?   @map("source_hash")
  aiExtraction  Json      @map("ai_extraction")
  decidedById   String?   @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor     User              @relation("OwnerReportActor", fields: [actorId], references: [id], onDelete: Restrict)
  decidedBy User?             @relation("OwnerReportDecision", fields: [decidedById], references: [id], onDelete: Restrict)
  items     OwnerReportItem[]

  @@index([storeId])
  @@index([storeId, status, createdAt])
  @@index([actorId])
  @@index([decidedById])
  @@map("owner_reports")
}

/// One extracted line of an owner report. `listingId` is null when nothing matched; such a line stays `unmatched`.
model OwnerReportItem {
  id              String   @id @default(cuid())
  reportId        String   @map("report_id")
  storeId         String   @map("store_id")
  extractedName   String   @map("extracted_name")
  extractedQty    Int?     @map("extracted_qty")
  unit            String?
  listingId       String?  @map("listing_id")
  matchConfidence Float    @default(0) @map("match_confidence")
  /// restock (counted listing) | set_status (status listing, to in_stock)
  kind            String?
  proposedDelta   Int?     @map("proposed_delta")
  /// pending | confirmed | rejected | unmatched
  status          String
  createdAt       DateTime @default(now()) @map("created_at")

  report  OwnerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  listing Listing?    @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([reportId])
  @@index([listingId])
  @@map("owner_report_items")
}

model StoreBanner {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  title     String
  subtitle  String?
  ctaText   String?  @map("cta_text")
  ctaHref   String?  @map("cta_href")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, active, sortOrder])
  @@map("store_banners")
}

model StoreCollection {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  title       String
  subtitle    String?
  imageUrl    String?  @map("image_url")
  slug        String
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    Store                    @relation(fields: [storeId], references: [id])
  items    StoreCollectionListing[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, active, sortOrder])
  @@map("store_collections")
}

model StoreCollectionListing {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  listingId    String   @map("listing_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([collectionId, listingId])
  @@index([collectionId])
  @@index([listingId])
  @@map("store_collection_listings")
}

model Cart {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  userId          String?  @map("user_id")
  customerId      String?  @map("customer_id")
  paymentIntentId     String? @unique @map("payment_intent_id")
  paymentAttemptToken String? @map("payment_attempt_token")
  purchaseEpoch       Int     @default(0) @map("purchase_epoch")
  deliveryLine1       String? @map("delivery_line1")
  deliveryLine2       String? @map("delivery_line2")
  deliveryCity        String? @map("delivery_city")
  deliveryState       String? @map("delivery_state")
  deliveryZip         String? @map("delivery_zip")
  deliveryLat         Float?  @map("delivery_lat")
  deliveryLng         Float?  @map("delivery_lng")
  leaveAtDoor         Boolean @default(false) @map("leave_at_door")
  source              String  @default("manual")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  /// Last time the orphan-hold sweep found this cart's intent not held; cleared when the shopper reopens payment.
  orphanCheckedAt DateTime? @map("orphan_checked_at")

  store    Store     @relation(fields: [storeId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id])
  lines    CartLine[]
  aiConversations AiConversation[]
  assistantUndoReceipts AssistantUndoReceipt[]
  guestBrowserCarts GuestBrowserCart[]

  @@index([storeId])
  @@index([storeId, userId])
  @@index([userId])
  @@index([customerId])
  @@map("carts")
}

/// A PaymentIntent reserved for release. Placement and release take the same
/// locks, and this row is the decision: the intent becomes an order, or it is
/// released. Stripe is told only after the row commits.
model PaymentIntentRelease {
  paymentIntentId String   @id @map("payment_intent_id")
  storeId         String   @map("store_id")
  createdAt       DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("payment_intent_releases")
}

model CartLine {
  id                  String   @id @default(cuid())
  storeId             String   @map("store_id")
  cartId              String   @map("cart_id")
  variantId           String   @map("variant_id")
  qty                 Int
  source              String   @default("manual")
  swapRule            String   @default("exact_only") @map("swap_rule")
  substituteVariantId String?  @map("substitute_variant_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant           ListingVariant  @relation(fields: [variantId], references: [id])
  substituteVariant ListingVariant? @relation("substituteVariant", fields: [substituteVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([storeId])
  @@index([cartId])
  @@index([variantId])
  @@index([substituteVariantId])
  @@map("cart_lines")
}

model Customer {
  id               String   @id @default(cuid())
  storeId          String   @map("store_id")
  userId           String?  @map("user_id")
  name             String
  email            String?
  phone            String?
  marketingConsent Boolean  @default(false) @map("marketing_consent")
  notes            String?
  /// The account Customer at this store that claimed this guest row (Claimed order). Set once.
  claimedByCustomerId String?   @map("claimed_by_customer_id")
  claimedAt           DateTime? @map("claimed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store  Store    @relation(fields: [storeId], references: [id])
  user   User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  claimedBy     Customer?  @relation("CustomerClaim", fields: [claimedByCustomerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Cascade)
  claimedGuests Customer[] @relation("CustomerClaim")
  orders Order[]
  carts  Cart[]
  aiConversations AiConversation[]

  @@unique([id, storeId])
  @@index([storeId])
  @@index([storeId, email])
  @@index([storeId, claimedByCustomerId])
  @@index([userId])
  @@map("customers")
}

/// Shopper assistant transcript. One row per cart. Store copilot records are #142/#144.
model AiConversation {
  id            String    @id @default(cuid())
  storeId       String    @map("store_id")
  cartId        String    @map("cart_id")
  customerId    String?   @map("customer_id")
  model         String
  tokensIn      Int       @default(0) @map("tokens_in")
  tokensOut     Int       @default(0) @map("tokens_out")
  costMicros    BigInt    @default(0) @map("cost_micros")
  messages      Json      @default("[]")
  /// Shopper constraints (#485): what to avoid, what must hold, and unknown items the customer confirmed.
  constraints   Json      @default("{}")
  /// Assistant checkout draft (#247): fulfillment and pickup slot for the normal checkout page.
  checkoutDraft Json?     @map("checkout_draft")
  inFlightUntil DateTime? @map("in_flight_until")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  actions  AiAction[]

  @@unique([storeId, cartId])
  @@index([cartId])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@map("ai_conversations")
}

model AiAction {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  conversationId String   @map("conversation_id")
  tool           String
  input          Json
  output         Json
  ok             Boolean
  createdAt      DateTime @default(now()) @map("created_at")

  store        Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([storeId])
  @@index([createdAt])
  @@index([storeId, tool, createdAt])
  @@map("ai_actions")
}

/// One row per assistant addition the customer undoes. A retry sees the row and does not subtract again.
model AssistantUndoReceipt {
  id         String   @id @default(cuid())
  storeId    String   @map("store_id")
  cartId     String   @map("cart_id")
  lineId     String   @map("line_id")
  additionId String   @map("addition_id")
  subtracted Int
  createdAt  DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([storeId, cartId, additionId])
  @@index([storeId])
  @@index([cartId])
  @@map("assistant_undo_receipts")
}

/// The cart a browser opened before its cart cookie was stored. One browser, one guest cart.
model GuestBrowserCart {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  browserId String   @map("browser_id")
  cartId    String   @map("cart_id")
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([storeId, browserId])
  @@index([cartId])
  @@map("guest_browser_carts")
}

/// Platform-wide shopper-assistant spend. No store id, and retention does not delete it.
model AssistantSpendDay {
  day          DateTime  @id @db.Date
  costMicros   BigInt    @default(0) @map("cost_micros")
  capAlertedAt DateTime? @map("cap_alerted_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("assistant_spend_days")
}

/// One row per provider call so a lost acknowledgement cannot increment the day twice.
model AssistantSpendCall {
  id         String   @id
  day        DateTime @db.Date
  costMicros BigInt   @map("cost_micros")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("assistant_spend_calls")
}

/// Recipe base (#25). Platform-shared like master products: seeded dishes, plus dishes the
/// shopper assistant looked up online, saved as ingredient names and a source link only.
model Recipe {
  id        String   @id @default(cuid())
  /// Folded dish name; a request matches this or one of the aliases.
  key       String   @unique
  name      String
  aliases   String[] @default([])
  cuisine   String?
  /// Servings the quantities are for. Null when the recipe has no quantities (looked up).
  servings  Int?
  sourceUrl String?  @map("source_url")
  origin    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  recipeId        String   @map("recipe_id")
  position        Int
  name            String
  masterProductId String?  @map("master_product_id")
  qty             Decimal? @db.Decimal(10, 3)
  unit            String?

  recipe        Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct? @relation(fields: [masterProductId], references: [id], onDelete: SetNull)

  @@unique([recipeId, position])
  @@index([masterProductId])
  @@map("recipe_ingredients")
}

/// Committed retention batch. A replay of the same key returns this count.
model AssistantRetentionBatch {
  id      String @id
  deleted Int

  @@map("assistant_retention_batches")
}

model Order {
  id                   String    @id @default(cuid())
  storeId              String    @map("store_id")
  number               Int
  customerId           String    @map("customer_id")
  status               String    @default("AUTHORIZED")
  fulfillment          String    @default("pickup")
  pickupSlot           String?   @map("pickup_slot")
  subtotalCents        Int       @map("subtotal_cents")
  tipCents             Int       @default(0) @map("tip_cents")
  bufferCents          Int       @map("buffer_cents")
  totalAuthorizedCents Int       @map("total_authorized_cents")
  paymentIntentId      String?   @unique @map("payment_intent_id")
  sourceCartId         String?   @map("source_cart_id")
  capturedAmountCents  Int?      @map("captured_amount_cents")
  refundId             String?   @map("refund_id")
  platformFeeCents     Int?      @map("platform_fee_cents")
  deliveryFeeCents     Int       @default(0) @map("delivery_fee_cents")
  /// Customer service fee (ADR-0021), on the quote and then on the goods picked at capture.
  serviceFeeCents      Int       @default(0) @map("service_fee_cents")
  /// The fee settings the order was quoted with; 0 on orders placed before the fee.
  serviceFeeBps        Int       @default(0) @map("service_fee_bps")
  serviceFeeMinCents   Int       @default(0) @map("service_fee_min_cents")
  serviceFeeMaxCents   Int       @default(0) @map("service_fee_max_cents")
  deliveryLine1        String?   @map("delivery_line1")
  deliveryLine2        String?   @map("delivery_line2")
  deliveryCity         String?   @map("delivery_city")
  deliveryState        String?   @map("delivery_state")
  deliveryZip          String?   @map("delivery_zip")
  deliveryLat          Float?    @map("delivery_lat")
  deliveryLng          Float?    @map("delivery_lng")
  deliveryDistanceMi   Float?    @map("delivery_distance_mi")
  leaveAtDoor          Boolean   @default(false) @map("leave_at_door")
  totalCents           Int       @default(0) @map("total_cents")
  notes                String?
  prepEstimateMinutes  Int?      @map("prep_estimate_minutes")
  acceptedAt           DateTime? @map("accepted_at")
  readyAt              DateTime? @map("ready_at")
  completedAt          DateTime? @map("completed_at")
  cancelledAt          DateTime? @map("cancelled_at")
  inngestEventSentAt   DateTime? @map("inngest_event_sent_at")
  trackingToken        String?   @unique @map("tracking_token")
  /// When the acceptance alert and auto-cancel start counting. NULL means created_at (orders before #167).
  acceptanceClockStartsAt DateTime? @map("acceptance_clock_starts_at") @db.Timestamptz(6)
  outForDeliveryAt     DateTime? @map("out_for_delivery_at")
  deliveredAt          DateTime? @map("delivered_at")
  deliveryProofKey     String?   @map("delivery_proof_key")
  deliveryProofUploadedAt DateTime? @map("delivery_proof_uploaded_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  store    Store      @relation(fields: [storeId], references: [id])
  customer Customer   @relation(fields: [customerId, storeId], references: [id, storeId])
  lines    OrderLine[]
  refundRequests RefundRequest[]
  issueReports   IssueReport[]
  notificationLogs NotificationLog[]
  deliveryEvents DeliveryEvent[]
  deliveries     Delivery[]
  supportThreads SupportThread[]
  substitutionRequests SubstitutionRequest[]

  @@unique([id, storeId])
  @@unique([storeId, number])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, sourceCartId, createdAt])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@map("orders")
}

/// One refund the app asked Stripe for. Stripe owns the outcome; this row owns the request.
model RefundRequest {
  id                   String   @id @default(cuid())
  storeId              String   @map("store_id")
  orderId              String   @map("order_id")
  paymentIntentId      String   @map("payment_intent_id")
  key                  String   @unique
  amountCents          Int      @map("amount_cents")
  refundApplicationFee Boolean  @map("refund_application_fee")
  state                String
  providerRefundId     String?  @map("provider_refund_id")
  providerStatus       String?  @map("provider_status")
  /// #495: on a courier issue refund, the service fee part the platform returns from its application fee.
  serviceFeeShareCents Int      @default(0) @map("service_fee_share_cents")
  feeRefundId          String?  @map("fee_refund_id")
  createdAt            DateTime @default(now()) @map("created_at")
  lastCheckedAt        DateTime @default(now()) @map("last_checked_at")

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
  @@index([storeId, state])
  @@map("refund_requests")
}

/// One customer report per order (#428). State: auto_refunded, in_review, approved, declined, refund_failed.
model IssueReport {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  orderId         String   @unique @map("order_id")
  type            String
  /// [{ lineId, qty }] chosen by the customer.
  lines           Json
  note            String?
  photoKey        String?  @map("photo_key")
  amountCents     Int      @map("amount_cents")
  state           String
  refundRequestId String?  @unique @map("refund_request_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, state])
  @@map("issue_reports")
}

/// One send attempt for one order event and channel. Contact is read from the order at send time.
model NotificationLog {
  id                String    @id @default(cuid())
  storeId           String    @map("store_id")
  orderId           String    @map("order_id")
  event             String
  channel           String
  status            String    @default("pending")
  reason            String?
  providerMessageId String?   @map("provider_message_id")
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  sentAt            DateTime? @map("sent_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([orderId, event, channel])
  @@index([storeId])
  @@index([storeId, orderId])
  @@index([status, createdAt])
  @@map("notification_logs")
}

/// One store-delivery step: out_for_delivery or delivered.
/// One courier booking for an order (DoorDash Drive or Uber Direct). Fees are the provider's quote, no markup (ADR-0006).
model Delivery {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  orderId        String   @map("order_id")
  provider       String
  externalId     String   @map("external_id")
  status         String
  quoteFeeCents  Int      @map("quote_fee_cents")
  actualFeeCents Int?     @map("actual_fee_cents")
  trackingUrl    String?  @map("tracking_url")
  courierJson    Json?    @map("courier_json")
  proofUrl       String?  @map("proof_url")
  pin            String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store  Store           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order  Order           @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  events DeliveryEvent[]

  @@unique([id, storeId])
  @@unique([provider, externalId])
  @@index([storeId, orderId])
  @@map("deliveries")
}

/// Store delivery steps (#134) and courier webhook events (#135). created_at is when the event was received.
model DeliveryEvent {
  id              String   @id @default(cuid())
  storeId         String   @map("store_id")
  orderId         String   @map("order_id")
  deliveryId      String?  @map("delivery_id")
  externalEventId String?  @map("external_event_id")
  type            String
  payload         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order    Order     @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  delivery Delivery? @relation(fields: [deliveryId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([deliveryId, externalEventId])
  @@index([storeId])
  @@index([storeId, orderId])
  @@map("delivery_events")
}

/// Platform-wide settings, one row with id "platform". Readable by every app user; platform admins write.
model PlatformSettings {
  id                   String   @id @default("platform")
  courierWeightLimitLb Int      @default(50) @map("courier_weight_limit_lb")
  /// Customer service fee (ADR-0021): rate in basis points, held between min and max cents.
  serviceFeeBps        Int      @default(300) @map("service_fee_bps")
  serviceFeeMinCents   Int      @default(99) @map("service_fee_min_cents")
  serviceFeeMaxCents   Int      @default(299) @map("service_fee_max_cents")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Support thread: one per order, customer and store messages about that order.
model SupportThread {
  id             String    @id @default(cuid())
  storeId        String    @map("store_id")
  orderId        String    @unique @map("order_id")
  topic          String    @default("order")
  state          String    @default("open")
  lastCustomerAt DateTime? @map("last_customer_at")
  lastReplyAt    DateTime? @map("last_reply_at")
  escalatedAt    DateTime? @map("escalated_at")
  escalationReason String? @map("escalation_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order    Order            @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  messages SupportMessage[]

  @@unique([id, storeId])
  @@index([storeId, lastCustomerAt])
  @@index([escalatedAt])
  @@map("support_threads")
}

model SupportMessage {
  id           String   @id @default(cuid())
  storeId      String   @map("store_id")
  threadId     String   @map("thread_id")
  sender       String
  senderUserId String?  @map("sender_user_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  store      Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  thread     SupportThread @relation(fields: [threadId, storeId], references: [id, storeId], onDelete: Cascade)
  senderUser User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([threadId, createdAt])
  @@index([senderUserId])
  @@map("support_messages")
}

model OrderLine {
  id                  String   @id @default(cuid())
  storeId             String   @map("store_id")
  orderId             String   @map("order_id")
  listingVariantId    String   @map("listing_variant_id")
  substituteVariantId String?  @map("substitute_variant_id")
  qtyOrdered          Int      @map("qty_ordered")
  qtyPicked           Int      @default(0) @map("qty_picked")
  unitPriceCents      Int      @map("unit_price_cents")
  swapRule            String   @default("exact_only") @map("swap_rule")
  status              String   @default("pending")
  /// The variant the customer's answer or swap rule put in for the units found short (#13).
  substitutedVariantId      String? @map("substituted_variant_id")
  substitutedUnitPriceCents Int?    @map("substituted_unit_price_cents")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  order              Order          @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  listingVariant     ListingVariant @relation(fields: [listingVariantId], references: [id])
  substituteVariant  ListingVariant? @relation("substituteOrderLine", fields: [substituteVariantId], references: [id], onDelete: Restrict)
  substitutedVariant ListingVariant? @relation("substitutedOrderLine", fields: [substitutedVariantId], references: [id], onDelete: Restrict)
  substitutionRequest SubstitutionRequest?

  @@index([storeId])
  @@index([orderId])
  @@index([listingVariantId])
  @@index([substituteVariantId])
  @@index([substitutedVariantId])
  @@map("order_lines")
}

/// One customer prompt for one short line (#13). Status: pending, approved, declined, timed_out.
model SubstitutionRequest {
  id                     String    @id @default(cuid())
  storeId                String    @map("store_id")
  orderId                String    @map("order_id")
  orderLineId            String    @unique @map("order_line_id")
  /// Null when only a refund is offered.
  proposedVariantId      String?   @map("proposed_variant_id")
  proposedUnitPriceCents Int?      @map("proposed_unit_price_cents")
  /// Units found short: a swap replaces this many.
  qty                    Int
  status                 String    @default("pending")
  expiresAt              DateTime  @map("expires_at")
  answeredAt             DateTime? @map("answered_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  store           Store           @relation(fields: [storeId], references: [id])
  order           Order           @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  orderLine       OrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  proposedVariant ListingVariant? @relation(fields: [proposedVariantId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([orderId])
  @@index([proposedVariantId])
  @@map("substitution_requests")
}

model ListingImport {
  id          String    @id @default(cuid())
  storeId     String    @map("store_id")
  csvText     String    @map("csv_text")
  rowCount    Int       @map("row_count")
  status      String    @default("pending")
  createdById String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  committedAt  DateTime? @map("committed_at")
  commitResult Json?     @map("commit_result")

  store     Store @relation(fields: [storeId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([storeId, status])
  @@map("listing_imports")
}

/// Platform account profile. One row per login. Not store-scoped.
model PlatformCustomerProfile {
  userId                        String    @id @map("user_id")
  stripeCustomerId              String?   @unique @map("stripe_customer_id")
  stripeCustomerStatus          String?   @map("stripe_customer_status")
  stripeCustomerIdempotencyKey  String?   @map("stripe_customer_idempotency_key")
  stripeCustomerAttemptedAt     DateTime? @map("stripe_customer_attempted_at")
  phone                         String?
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_customer_profiles")
}

/// A delivery address saved on the customer's account. Copied onto an order only by #15.
model CustomerAddress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  notes     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("customer_addresses")
}

/// Affirmative consent to reuse a card at any store. The payment method id is a Stripe token, not card data.
model CardSaveConsent {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  paymentIntentId   String   @map("payment_intent_id")
  paymentMethodId   String?  @map("payment_method_id")
  stripeCustomerId  String?  @map("stripe_customer_id")
  termsVersion      String   @map("terms_version")
  purpose           String
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, paymentMethodId])
  @@map("card_save_consents")
}

/// A store member's browser that gets a web push for each new order.
model PushSubscription {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

/// Store subscription on Stripe Billing (#494, ADR-0021). Billing state comes from Stripe webhooks; the admin sets `pilot`.
model StoreSubscription {
  storeId              String    @id @map("store_id")
  plan                 String    @default("starter")
  /// Stripe's subscription status, or "none" before the owner subscribes.
  status               String    @default("none")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  trialEndsAt          DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  pilot                Boolean   @default(false)
  paymentFailedAt      DateTime? @map("payment_failed_at") @db.Timestamptz(6)
  /// Creation time of the last subscription event applied; an older event arriving late is skipped.
  lastEventAt          DateTime? @map("last_event_at") @db.Timestamptz(6)
  /// The owner's open Stripe Checkout; expired before another opens, cleared when the subscription arrives.
  checkoutSessionId    String?   @map("checkout_session_id")
  /// Creation time of the newest paid invoice event; an older payment failure arriving late is skipped.
  lastInvoicePaidAt    DateTime? @map("last_invoice_paid_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@map("store_subscriptions")
}

/// One row per Stripe billing event applied, so a replay changes nothing.
model StripeBillingEvent {
  id        String   @id
  storeId   String?  @map("store_id")
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  store Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@map("stripe_billing_events")
}

/// Shopper assistant chats per store per calendar month (UTC), for the plan cap.
model AssistantChatMonth {
  storeId  String    @map("store_id")
  month    DateTime  @db.Date
  chats    Int       @default(0)
  warnedAt DateTime? @map("warned_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, month])
  @@map("assistant_chat_months")
}
